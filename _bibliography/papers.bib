  booktitle   = {ECCV Workshop on the AI City Challenge},
  year        = {2026},
  selected    = {true},
  note        = {Accepted as poster. AI City Challenge 2026 Track 3.},
  abstract    = {A compact VLM pipeline built on a shared Qwen3-VL-8B backbone with task-routed LoRA variants. Introduces trajectory visual prompting: the tracked motion trail of each vehicle is drawn onto the frames before retraining, which produced the largest measured long-form gain on causal linkage.}
}

