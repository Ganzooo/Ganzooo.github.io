@inproceedings{jeong2026modular,
  abbr        = {ECCVW},
  bibtex_show = {true},
  title       = {Modular Spatial Grounding for Sim2Real Traffic-Safety VQA},
  author      = {Jeong, Jinwoo and Kim, Sungjei and Gankhuyag, Ganzorig},
  booktitle   = {ECCV Workshop on the AI City Challenge},
  year        = {2026},
  selected    = {true},
  note        = {Corresponding author. Accepted as poster.},
  abstract    = {A Qwen3-VL-8B system for Sim2Real spatial VQA on WTS/SynWTS. The Spatial Grounding Adapter is a deterministic post-model component that routes supported spatial questions to pose or bird's-eye geometry estimators and retains the VLM answer when the geometry is invalid, raising real-domain VQA from 80.63% to 81.61%. Ranked 3rd on the final public leaderboard at 83.54% VQA accuracy.}
}

@inproceedings{gankhuyag2026motiontrails,
